<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CourseWork_db.Views.AdminPanelView">

  <DockPanel Margin="16">
    <TabControl x:Name="Tabs">

      <TabItem Header="Станції">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Станція"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуюча станція" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingStationBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва" Classes="label"/>
                  <TextBox x:Name="StationNameBox" Watermark="Назва станції"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Місто" Classes="label"/>
                  <TextBox x:Name="StationCityBox" Watermark="Місто"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Країна" Classes="label"/>
                  <TextBox x:Name="StationCountryBox" Watermark="Країна"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddStationButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateStationButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteStationButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="StationMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Маршрути">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Новий маршрут"
                           Classes="heading"
                           HorizontalAlignment="Center"/>
                <StackPanel Spacing="4">
                  <TextBlock Text="Назва маршруту" Classes="label"/>
                  <TextBox x:Name="RouteNameBox" Watermark="Наприклад: Київ — Львів"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,8,*">
                  <Button x:Name="SaveRouteBtn"
                          Content="✓ Зберегти маршрут" Classes="primary" Width="120"/>
                  <Button Grid.Column="2" x:Name="ClearRouteBtn"
                          Content="Очистити" Classes="secondary" Width="120"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Зупинки маршруту"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <Grid ColumnDefinitions="*,8,*,8,Auto,8,Auto">
                  <Button Grid.Column="0" x:Name="AddStationCardBtn"
                          Content="+ Станція" Classes="secondary"/>
                  <Button Grid.Column="2" x:Name="RemoveStationCardBtn"
                          Content="− Видалити" Classes="secondary"/>
                  <Button Grid.Column="4" x:Name="MoveUpBtn"
                          Content="↑" Classes="secondary" Width="48"/>
                  <Button Grid.Column="6" x:Name="MoveDownBtn"
                          Content="↓" Classes="secondary" Width="48"/>
                </Grid>

                <StackPanel x:Name="RouteStationsCardsPanel" Spacing="6"/>

                <Border Classes="card-info" Padding="12,10">
                  <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Відстань:" Classes="label" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TotalDistanceText" Text="0 км"
                                 FontWeight="SemiBold" Foreground="#C2185B"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Тривалість:" Classes="label" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TotalDurationText" Text="0 год 0 хв"
                                 FontWeight="SemiBold" Foreground="#C2185B"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="RouteDetailMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Існуючі маршрути"
                           Classes="heading"
                           HorizontalAlignment="Center"/>
                <StackPanel Spacing="4">
                  <TextBlock Text="Маршрут" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingRouteBox" Watermark="Оберіть маршрут…" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="LoadRouteButton"
                          Content="Завантажити" Classes="secondary" Width="120"/>
                  <Button x:Name="UpdateRouteButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteRouteButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>
                <TextBlock x:Name="RouteMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Поїзди">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Поїзд"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий поїзд" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingTrainBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва поїзда" Classes="label"/>
                  <TextBox x:Name="TrainNameBox" Watermark="Наприклад: Intercity 741"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddTrainButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateTrainButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteTrainButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="TrainMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Типи вагонів">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Назва типу вагона"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуюча назва" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingCarTypeNameBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва" Classes="label"/>
                  <TextBox x:Name="CarTypeNameValueBox" Watermark="Наприклад: Купе, Плацкарт"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddCarTypeNameButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateCarTypeNameButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteCarTypeNameButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="CarTypeNameMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Етап модернізації"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий етап" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingStageBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва" Classes="label"/>
                  <TextBox x:Name="StageNameBox" Watermark="Наприклад: Базовий, Покращений"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddStageButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateStageButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteStageButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="StageMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Тип вагона (комбінація)"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий тип" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingCarTypeBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва типу" Classes="label"/>
                  <AutoCompleteBox x:Name="CarTypeNameBox" Watermark="Оберіть назву" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Етап модернізації" Classes="label"/>
                  <AutoCompleteBox x:Name="ModernizationStageBox" Watermark="Оберіть етап" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Ціна за 1 км (грн)" Classes="label"/>
                  <TextBox x:Name="CarTypePriceBox" Watermark="Наприклад: 2.50"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Вартість обслуговування (грн)" Classes="label"/>
                  <TextBox x:Name="CarTypeServicePriceBox" Watermark="Наприклад: 50.00"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddCarTypeButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateCarTypeButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteCarTypeButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="CarTypeMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Дозволені характеристики для типу"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий зв'язок" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingAllowedCharBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Тип вагона" Classes="label"/>
                  <AutoCompleteBox x:Name="AllowedCharCarTypeBox" Watermark="Оберіть тип вагона" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Характеристика" Classes="label"/>
                  <AutoCompleteBox x:Name="AllowedCharBox" Watermark="Оберіть характеристику" FilterMode="Contains"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddAllowedCharButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="DeleteAllowedCharButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="AllowedCharMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Вагони">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Вагон"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий вагон" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingCarBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Поїзд" Classes="label"/>
                  <AutoCompleteBox x:Name="CarTrainBox" Watermark="Оберіть поїзд" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Тип вагона" Classes="label"/>
                  <AutoCompleteBox x:Name="CarTypeBox" Watermark="Оберіть тип вагона" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Кількість місць" Classes="label"/>
                  <TextBox x:Name="SeatsCountBox" Watermark="Наприклад: 54"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddCarButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateCarButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteCarButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="CarMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Рейси">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Рейс"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий рейс" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingTripBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Маршрут" Classes="label"/>
                  <AutoCompleteBox x:Name="TripRouteBox" Watermark="Оберіть маршрут" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Поїзд" Classes="label"/>
                  <AutoCompleteBox x:Name="TripTrainBox" Watermark="Оберіть поїзд" FilterMode="Contains"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,12,*">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Дата відправлення" Classes="label"/>
                    <DatePicker x:Name="DepartureDatePicker"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Дата прибуття" Classes="label"/>
                    <DatePicker x:Name="ArrivalDatePicker"/>
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddTripButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateTripButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteTripButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="TripMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Характеристики">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Тип характеристики місця"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий тип" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingCharTypeBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва" Classes="label"/>
                  <TextBox x:Name="CharTypeNameBox" Watermark="Наприклад: Біля вікна/проходу"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddCharTypeButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateCharTypeButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteCharTypeButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="CharTypeMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Характеристика місця"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуюча характеристика" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingCharBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Тип" Classes="label"/>
                  <AutoCompleteBox x:Name="CharTypeSelectorBox" Watermark="Оберіть тип" FilterMode="Contains"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Значення" Classes="label"/>
                  <TextBox x:Name="CharValueBox" Watermark="Наприклад: Біля вікна"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddCharButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdateCharButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeleteCharButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="CharMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Інше">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12"
                      MaxWidth="560"
                      Margin="0,12,0,80">

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Пріоритет місця"
                           Classes="heading"
                           HorizontalAlignment="Center"/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Існуючий пріоритет" Classes="label"/>
                  <AutoCompleteBox x:Name="ExistingPriorityBox" Watermark="Оберіть для редагування…" FilterMode="Contains"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                  <TextBlock Text="Назва" Classes="label"/>
                  <TextBox x:Name="PriorityNameBox" Watermark="Наприклад: Високий, Середній"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            HorizontalAlignment="Center">
                  <Button x:Name="AddPriorityButton"
                          Content="Додати" Classes="primary" Width="120"/>
                  <Button x:Name="UpdatePriorityButton"
                          Content="Оновити" Classes="secondary" Width="120"/>
                  <Button x:Name="DeletePriorityButton"
                          Content="Видалити" Classes="danger" Width="120"/>
                </StackPanel>

                <TextBlock x:Name="PriorityMsg"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           TextAlignment="Center"
                           FontSize="13"/>
              </StackPanel>
            </Border>



          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>

</UserControl>
